{
  "python.defaultInterpreterPath": "${workspaceFolder}/printer_bridge/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/printer_bridge/src"
  ],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/.venv",
    "**/dist",
    "**/.angular"
  ],
  "python.analysis.ignore": [
    "**/node_modules",
    "**/.venv",
    "**/dist",
    "**/.angular"
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/.angular/**": true
  }
}
